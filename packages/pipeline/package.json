    "@hyperframes/player": "^0.4.17",
    "dotenv": "^17.4.1",
    "music-metadata": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
